	eprint = {2504.03846 [cs.CL]},
	keywords = {Computer Science - Computation and Language},
	file = {PDF:C\:\\Users\\USER\\Zotero\\storage\\7I6I4KU7\\Chen et al. - 2025 - Do LLM Evaluators Prefer Themselves for a Reason.pdf:application/pdf},
