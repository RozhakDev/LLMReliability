@misc{yagubyanCoinFlipJudge2026,
  title = {The {{Coin Flip Judge}}? {{Reliability}} and {{Bias}} in {{LLM}}-as-a-{{Judge Evaluation}}},
  shorttitle = {The {{Coin Flip Judge}}?},
  author = {Yagubyan, Abel},
