	file = {PDF:C\:\\Users\\USER\\Zotero\\storage\\BMGJ39XF\\Son et al. - 2025 - MM-Eval A Multilingual Meta-Evaluation Benchmark for LLM-as-a-Judge and Reward Models.pdf:application/pdf},
