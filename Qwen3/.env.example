# Colab Drive mount and workspace directories
DRIVE_MOUNT_POINT=/content/drive
PROJECT_ROOT=/content/drive/MyDrive/LLMReliabilityQwen3
QWEN3_DIR=/content/drive/MyDrive/LLMReliabilityQwen3/Qwen3
MODELS_CACHE_DIR=/content/models

# Config files (relative to QWEN3_DIR or absolute path)
EXPERIMENT_CONFIG_PATH=configs/experiment.yaml
MODEL_CONFIG_PATH=configs/model.yaml
PROMPTS_CONFIG_PATH=configs/prompts.yaml

# Hugging Face auth (use HF_SECRETS_FILE on Drive, Colab Secrets, or set HF_TOKEN locally; never commit tokens)
HF_SECRETS_FILE=/content/drive/MyDrive/secrets.json
HF_TOKEN=

# Logging and Hub output
LOG_LEVEL=INFO
LOG_TIMEZONE=Asia/Jakarta
HF_HUB_DISABLE_PROGRESS_BARS=1
