# Profil Lingkungan Eksekusi: LOCAL_CPU | VPS_CPU | COLAB_GPU
LLM_COMPUTE_ENV=LOCAL_CPU

# Direktori Data & Sink Artefak
# Default lokal: UI/data (otomatis terdeteksi)
# Default Colab: /content/drive/MyDrive/LLMReliability
DATA_ROOT=
DRIVE_ROOT=/content/drive/MyDrive/LLMReliability

# Manajemen Bobot Model
# Default lokal: UI/data/models
MODEL_DIR=
# Path spesifik berkas GGUF jika berada di luar direktori model default
LOCAL_GGUF_PATH=

# Parameter Inferensi CPU (Ryzen 3 / VPS)
CPU_THREADS=4
LLM_CONTEXT_SIZE=2048
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=16

# Ambang Batas Analisis Statistik & Visualisasi
STATISTICAL_ALPHA=0.05
FLIP_ALERT_THRESHOLD=20.0
CONSISTENCY_HIGH_THRESHOLD=70.0
